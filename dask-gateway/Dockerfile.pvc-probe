ARG CALRISSIAN_DASK_IMAGE=calrissian-dask:local
FROM ${CALRISSIAN_DASK_IMAGE}
COPY dist/calrissian-*.whl /tmp/pvc-wheels/
COPY calrissian-dask/dist/calrissian_dask-*.whl /tmp/pvc-wheels/
COPY scripts/bootstrap-pip.sh /tmp/bootstrap-pip.sh
RUN python -m ensurepip && sh /tmp/bootstrap-pip.sh && \
    python -m pip install --force-reinstall --no-deps /tmp/pvc-wheels/*.whl && \
    python -m pip install 'jsonschema>=4.23,<5' \
        'msgpack==1.2.1' 'tornado==6.5.9' \
        'dask==2026.3.0' 'distributed==2026.3.0' 'dask-gateway==2026.3.0' && \
    python -m pip check
