ARG CALRISSIAN_IMAGE=ghcr.io/duke-gcb/calrissian:latest
FROM rockylinux/rockylinux:10.2-minimal AS extension-builder
RUN microdnf -y update && \
    microdnf -y install ca-certificates python3 python3-pip python3-devel gcc gcc-c++ make git && \
    microdnf clean all
RUN /usr/bin/python3.12 -m venv /opt/build-venv
ENV PATH="/opt/build-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ENV VIRTUALENV_PIP=26.2.2
COPY scripts/bootstrap-pip.sh /tmp/bootstrap-pip.sh
RUN /bin/sh /tmp/bootstrap-pip.sh
ARG HATCH_VERSION=1.18.0
RUN python -m pip install --no-cache-dir "certifi>=2026.10.19" "uv>=0.13.4" "hatch==${HATCH_VERSION}"
WORKDIR /src
COPY . /src
RUN cd /src/calrissian-dask && hatch build -t wheel

FROM ${CALRISSIAN_IMAGE} AS runtime
COPY --from=extension-builder --chown=1001:0 /src/calrissian-dask/dist/ /app/dask-dist/
COPY --chown=1001:0 scripts/bootstrap-pip.sh /tmp/bootstrap-pip.sh
RUN python -m ensurepip && \
    sh /tmp/bootstrap-pip.sh && \
    python -m pip install --no-cache-dir --no-index --no-deps /app/dask-dist/*.whl && \
    python -m pip check && \
    python -m pip uninstall --yes pip && \
    rm -rf /app/dask-dist /tmp/bootstrap-pip.sh

CMD ["calrissian"]
