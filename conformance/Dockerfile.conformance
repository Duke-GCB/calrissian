# Skaffold supplies the image built from the production Dockerfile.
ARG CALRISSIAN_IMAGE
FROM ${CALRISSIAN_IMAGE}

# The production virtualenv deliberately has no pip. Restore it temporarily,
# and constrain installed packages so adding cwltest cannot upgrade the runtime.
RUN python -m ensurepip && \
    python -m pip freeze > /tmp/production-constraints.txt && \
    python -m pip install --no-cache-dir -c /tmp/production-constraints.txt cwltest && \
    python -m pip check && \
    python -m pip uninstall --yes pip && \
    rm /tmp/production-constraints.txt

CMD ["bash"]
