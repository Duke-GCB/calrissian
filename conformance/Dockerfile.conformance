FROM python:3.12-slim-bookworm
LABEL maintainer="dan.leehr@duke.edu"

# Use the updated OS trust store instead of Node's bundled CA snapshot.
ENV NODE_OPTIONS="--use-openssl-ca"

# cwltool requires nodejs
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates nodejs && \
    apt-get clean && rm -rf /var/lib/apt/lists/*

COPY scripts/bootstrap-pip.sh /tmp/bootstrap-pip.sh
RUN sh /tmp/bootstrap-pip.sh && \
    python -m pip install --no-cache-dir "certifi>=2026.10.19"

# To run conformance tests we must install cwltest
RUN pip install cwltest

RUN mkdir -p /app
COPY . /app
RUN pip install /app
WORKDIR /app

# Create a default user and home directory
ENV HOME=/home/calrissian
# home dir is created by useradd with group (g=0) to comply with
# https://docs.openshift.com/container-platform/3.11/creating_images/guidelines.html#openshift-specific-guidelines
RUN useradd -u 1001 -r -g 0 -m -d ${HOME} -s /sbin/nologin \
      -c "Default Calrissian User" calrissian && \
  chown -R 1001:0 /app && \
  chmod g+rwx ${HOME}

CMD ["bash"]
